# Credenciais do Supabase (worker usa a service role key)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your-service-role-key
SUPABASE_BUCKET=clips            # bucket público dos clipes
SOURCES_BUCKET=sources           # bucket privado dos vídeos originais

# Segredo compartilhado com a Vercel para autorizar POST /process
WORKER_SECRET=troque-por-um-segredo-forte

# Parâmetros de processamento (opcionais — estes são os defaults)
MAX_SOURCE_DURATION=10800        # duração máx. do vídeo original (3h); vale p/ YouTube
TOP_N=30
CLIP_DURATION=60
PRE_ROLL=5
MAX_CONCURRENT_JOBS=1            # jobs pesados em paralelo (threads consumindo a fila)
JOB_QUEUE_ENABLED=true           # false = BackgroundTasks em memória (perde job em redeploy)
JOB_POLL_SECONDS=5               # intervalo de consulta da fila quando ociosa
JOB_HEARTBEAT_SECONDS=30         # intervalo do heartbeat do job em andamento
JOB_STALE_SECONDS=180            # sem heartbeat por esse tempo = worker morto, job volta à fila
JOB_MAX_ATTEMPTS=3               # retomadas de um job interrompido antes de virar erro
FFMPEG_THREADS=2                 # threads do x264 por corte (limita a RAM)
OUTPUT_WIDTH=1080                # largura do clipe vertical 9:16 (crop central)
OUTPUT_HEIGHT=1920               # altura do clipe vertical 9:16

# Diretor de IA de visão (opcional): avalia a "vibe" do público via Claude para
# re-ranquear os cortes e dirigir os zooms. A Vercel só pede para planos pagos;
# sem ANTHROPIC_API_KEY, a fase degrada sozinha para a heurística local (YOLO).
ANTHROPIC_API_KEY=                # chave da API da Claude (vazio = IA desligada)
AI_DIRECTOR_ENABLED=true          # liga/desliga a fase de IA no worker
AI_CAMERA_ENABLED=true            # a IA monta os shots do corte dinâmico (false = YOLO + heurísticas)
AI_DIRECTOR_MODEL=claude-sonnet-5    # modelo que dirige a câmera (planos pagos)
AI_DIRECTOR_MAX_CALLS=30          # teto de janelas dirigidas por job (= máx. de cortes)
AI_DIRECTOR_FRAMES=12             # keyframes por janela: é o que a IA "vê" para dirigir
AI_DIRECTOR_FRAME_WIDTH=512       # largura (px) desses keyframes
AI_DIRECTOR_BUDGET_SECONDS=300    # teto de tempo da direção por job
AI_DIRECTOR_TIMEOUT=60            # timeout (s) de cada chamada
AI_CONCURRENCY=6                  # chamadas à IA em paralelo
RENDER_CONCURRENCY=1              # clipes renderizados em paralelo (2 = mais rápido, mais memória)
SCORE_HYPE_WEIGHT=0.35            # peso do hype da IA no score final do corte
